# Plugin description in the plugin list
msgid "Displays reading progress as a burn-up chart"
msgstr "Zeigt den Lesefortschritt als Burn-up-Chart an"

# Tooltip of the toolbar button
msgid "Display reading progress as a burn-up chart"
msgstr "Lesefortschritt als Burn-up-Chart anzeigen"

# Status bar error messages
msgid "Export failed: {}"
msgstr "Export fehlgeschlagen: {}"

msgid "Could not extract drawing script: {}"
msgstr "Zeichen-Skript konnte nicht extrahiert werden: {}"

msgid "zeichne_chart.py not found."
msgstr "zeichne_chart.py nicht gefunden."

msgid "Python not found: {}"
msgstr "Python nicht gefunden: {}"

msgid "Chart rendering failed: {}"
msgstr "Chart-Zeichnen fehlgeschlagen: {}"

msgid "Reading status: {read}/{total} read, backlog {backlog}"
msgstr "Lesestatus: {read}/{total} gelesen, Backlog {backlog}"

# Config dialog
msgid "Target date:"
msgstr "Zieldatum:"

msgid "Gentle reduction (factor):"
msgstr "Sanfter Abbau (Faktor):"

msgid "<b>Target date:</b> Date by which the backlog (TBR) should reach 0.<br><br><b>Gentle reduction:</b> Fraction of the TBR that remains at the target date. 0.50 means: TBR halved by the target date."
msgstr "<b>Zieldatum:</b> Datum, an dem der SuB (Backlog) auf 0 sein soll.<br><br><b>Sanfter Abbau:</b> Anteil des SuB, der am Zieldatum noch übrig bleibt. 0.50 bedeutet: SuB halbiert bis zum Zieldatum."

# Chart dialog
msgid "Reading progress"
msgstr "Lesefortschritt"

msgid "Chart not found:\n{}\n\nDid zeichne_chart.py run successfully?"
msgstr "Chart nicht gefunden:\n{}\n\nWurde zeichne_chart.py erfolgreich ausgeführt?"

msgid "Could not load PNG:\n{}"
msgstr "PNG konnte nicht geladen werden:\n{}"

msgid "Close"
msgstr "Schließen"

# Chart rendering (zeichne_chart.py)
msgid "Reading progress for TBR = {tbr} on {date}"
msgstr "Lesefortschritt für SuB = {tbr} am {date}"

msgid "Total library"
msgstr "Gesamtbestand"

msgid "Read (cumulative)"
msgstr "Gelesen (kumuliert)"

msgid "Backlog (TBR)"
msgstr "Backlog (SuB)"

msgid "Goal: TBR = 0 on {date}"
msgstr "Ziel: SuB = 0 am {date}"

msgid "Constant library (buy rate = read rate)"
msgstr "Bestand stabil (Kaufrate = Leserate)"

msgid "Gentle reduction to TBR = {tbr} by {year}"
msgstr "Sanfter Abbau auf SuB = {tbr} bis {year}"

msgid "Today: {count} unread"
msgstr "Heute: {count} ungelesen"

msgid "Number of books"
msgstr "Anzahl Bücher"

msgid "Year"
msgstr "Jahr"

# Config dialog: custom columns
msgid "Custom column \"read\":"
msgstr "Benutzerdefinierte Spalte \"gelesen\":"

msgid "Custom column \"last read\":"
msgstr "Benutzerdefinierte Spalte \"zuletzt gelesen\":"

msgid "<b>Target date:</b> Date by which the backlog (TBR) should reach 0.<br><br><b>Gentle reduction:</b> Fraction of the TBR that remains at the target date. 0.50 means: TBR halved by the target date.<br><br><b>Custom columns:</b> Names of your Calibre columns (with leading #) used to mark books as read and to store the last read date."
msgstr "<b>Zieldatum:</b> Datum, an dem der SuB (Backlog) auf 0 sein soll.<br><br><b>Sanfter Abbau:</b> Anteil des SuB, der am Zieldatum noch übrig bleibt. 0.50 bedeutet: SuB halbiert bis zum Zieldatum.<br><br><b>Benutzerdefinierte Spalten:</b> Namen deiner Calibre-Spalten (mit führendem #), die zum Markieren gelesener Bücher und zum Speichern des letzten Lesedatums dienen."

# Error message for missing matplotlib
msgid "Python 3 with matplotlib not found. Install it with: brew install python-matplotlib"
msgstr "Python 3 mit matplotlib nicht gefunden. Installation mit: brew install python-matplotlib"

msgid "matplotlib is missing in Python. Install it with: brew install python-matplotlib"
msgstr "matplotlib fehlt in Python. Installation mit: brew install python-matplotlib"