# Plugin description in the plugin list
msgid "Displays reading progress as a burn-up chart"
msgstr "Zeigt den Lesefortschritt als Burn-up-Chart an"

# Toolbar button
msgid "Burn-up Chart"
msgstr "Burn-up-Chart"

msgid "Reading statistics for your library"
msgstr "Lesestatistik für deine Bibliothek"

# Menu entries
msgid "Burn-up chart"
msgstr "Burn-up-Chart"

msgid "Time between purchase and reading"
msgstr "Zeit zwischen Kauf und Lesen"

# Status bar messages
msgid "Export failed: {}"
msgstr "Export fehlgeschlagen: {}"

msgid "Reading status: {read}/{total} read, backlog {backlog}"
msgstr "Lesestatus: {read}/{total} gelesen, Backlog {backlog}"

msgid "No data available for this analysis."
msgstr "Keine Daten für diese Auswertung verfügbar."

msgid "Median: {med} days, mean: {mean} days (n={n})"
msgstr "Median: {med} Tage, Mittel: {mean} Tage (n={n})"

# Config dialog
msgid "Target date:"
msgstr "Zieldatum:"

msgid "Gentle reduction (factor):"
msgstr "Sanfter Abbau (Faktor):"

msgid "Show forecast line"
msgstr "Prognoselinie anzeigen"

msgid "Total library color:"
msgstr "Farbe Gesamtbestand:"

msgid "Read (cumulative) color:"
msgstr "Farbe Gelesen (kumuliert):"

msgid "Backlog (TBR) color:"
msgstr "Farbe Backlog (SuB):"

msgid "Goal line color:"
msgstr "Farbe Ziellinie:"

msgid "Constant library line color:"
msgstr "Farbe stabile Bestandslinie:"

msgid "Gentle reduction line color:"
msgstr "Farbe Linie sanfter Abbau:"

msgid "Forecast line color:"
msgstr "Farbe Prognoselinie:"

msgid "Reset colors to theme defaults"
msgstr "Farben auf Theme-Standard zurücksetzen"

msgid "Custom column \"read\":"
msgstr "Benutzerdefinierte Spalte \"gelesen\":"

msgid "Custom column \"last read\":"
msgstr "Benutzerdefinierte Spalte \"zuletzt gelesen\":"

msgid "<b>Target date:</b> Date by which the backlog (TBR) should reach 0.<br><br><b>Gentle reduction:</b> Fraction of the TBR that remains at the target date. 0.50 means: TBR halved by the target date.<br><br><b>Custom columns:</b> Names of your Calibre columns (with leading #) used to mark books as read and to store the last read date."
msgstr "<b>Zieldatum:</b> Datum, an dem der SuB (Backlog) auf 0 sein soll.<br><br><b>Sanfter Abbau:</b> Anteil des SuB, der am Zieldatum noch übrig bleibt. 0.50 bedeutet: SuB halbiert bis zum Zieldatum.<br><br><b>Benutzerdefinierte Spalten:</b> Namen deiner Calibre-Spalten (mit führendem #), die zum Markieren gelesener Bücher und zum Speichern des letzten Lesedatums dienen."

# Chart dialog
msgid "Reading progress"
msgstr "Lesefortschritt"

msgid "Close"
msgstr "Schließen"

# Export buttons (both chart dialogs)
msgid "Save as PNG…"
msgstr "Als PNG speichern…"

msgid "Copy to clipboard"
msgstr "In Zwischenablage kopieren"

msgid "Save chart as PNG"
msgstr "Chart als PNG speichern"

msgid "PNG images"
msgstr "PNG-Bilder"

msgid "Export failed"
msgstr "Export fehlgeschlagen"

msgid "Could not write {path}."
msgstr "{path} konnte nicht geschrieben werden."

msgid "Chart copied to clipboard"
msgstr "Chart in die Zwischenablage kopiert"

msgid "Reading progress for TBR = {tbr} on {date}"
msgstr "Lesefortschritt für SuB = {tbr} am {date}"

msgid "Total library"
msgstr "Gesamtbestand"

msgid "Read (cumulative)"
msgstr "Gelesen (kumuliert)"

msgid "Backlog (TBR)"
msgstr "Backlog (SuB)"

msgid "Goal: TBR = 0 on {date}"
msgstr "Ziel: SuB = 0 am {date}"

msgid "Constant library (buy rate = read rate)"
msgstr "Bestand stabil (Kaufrate = Leserate)"

msgid "Gentle reduction to TBR = {tbr} by {year}"
msgstr "Sanfter Abbau auf SuB = {tbr} bis {year}"

msgid "Forecast (last 12 months)"
msgstr "Prognose (letzte 12 Monate)"

msgid "Realistic: TBR = 0 on {date}"
msgstr "Realistisch: SuB = 0 am {date}"

msgid "{date}\nTotal: {total}\nRead: {read}\nBacklog: {backlog}"
msgstr "{date}\nGesamt: {total}\nGelesen: {read}\nSuB: {backlog}"

msgid "Today: {count} unread"
msgstr "Heute: {count} ungelesen"

msgid "Number of books"
msgstr "Anzahl Bücher"

msgid "Year"
msgstr "Jahr"

msgid "No data"
msgstr "Keine Daten"

# Delay chart
msgid "Median: {med} days · Mean: {mean} days · Range: {min}–{max} days · n = {n}"
msgstr "Median: {med} Tage · Mittel: {mean} Tage · Spanne: {min}–{max} Tage · n = {n}"

msgid "Days until read"
msgstr "Tage bis zum Lesen"

msgid "Months until read"
msgstr "Monate bis zum Lesen"

msgid "Years until read"
msgstr "Jahre bis zum Lesen"

msgid "Read on"
msgstr "Gelesen am"

msgid "Median"
msgstr "Median"

msgid "Mean"
msgstr "Mittel"

# paintEvent error fallback
msgid "Error drawing:\n{type}: {error}\n\nDetails: {log}"
msgstr "Fehler beim Zeichnen:\n{type}: {error}\n\nDetails: {log}"
